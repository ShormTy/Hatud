rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Small helper checks ----

    function isSelf(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isText(value, maxLength) {
      return value is string && value.size() > 0 && value.size() <= maxLength;
    }

    function isPhone(value) {
      return value is string && value.matches('^[0-9+() -]{7,20}$');
    }

    // The pilot invite code. Only these rules can read it.
    function pilotCode() {
      return get(/databases/$(database)/documents/settings/pilot).data.inviteCode;
    }

    // ---- settings: never readable or writable from the app ----
    // The owner edits settings/pilot in the Firebase console.
    match /settings/{document=**} {
      allow read, write: if false;
    }

    // ---- admins: the owner's own login ----
    // The owner makes the document admins/{uid} by hand in the Firebase console
    // (the console ignores these rules). The app can never create or change it.
    match /admins/{uid} {
      allow read: if isSelf(uid) || isAdmin();
    }

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ---- users: one profile per person, readable only by that person ----
    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      // Not while the owner has a removedUsers note for this person (W6).
      allow create: if isSelf(uid)
        && !exists(/databases/$(database)/documents/removedUsers/$(uid))
        && (isNewStudent(request.resource.data) || isNewDriver(request.resource.data));
      // An admin can change only the blocked flag and who blocked the person (W22).
      // blockedBy is "owner" when the admin blocks, and it is removed again on unblock.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['blocked', 'blockedBy', 'blockedAt'])
        && request.resource.data.blocked is bool
        && (!('blockedBy' in request.resource.data)
            || request.resource.data.blockedBy == null
            || request.resource.data.blockedBy == 'owner')
        // W27b: the date of the block is the server time (or removed again on unblock).
        && (!('blockedAt' in request.resource.data)
            || request.resource.data.blockedAt == null
            || request.resource.data.blockedAt == request.time
            || request.resource.data.blockedAt == resource.data.get('blockedAt', null));
      // Automatic block (W22): a person who reported this account can set blocked to true,
      // but only when the private list of different reporters (reportTally) holds 3 or more
      // people, and he is one of them. Nothing else can change.
      allow update: if request.auth != null
        && resource.data.blocked == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['blocked', 'blockedBy', 'blockedAt'])
        && request.resource.data.blocked == true
        && request.resource.data.blockedBy == 'auto'
        && (!('blockedAt' in request.resource.data) || request.resource.data.blockedAt == request.time)
        && exists(/databases/$(database)/documents/reportTally/$(uid))
        && get(/databases/$(database)/documents/reportTally/$(uid)).data.reporters.size() >= 3
        && request.auth.uid in get(/databases/$(database)/documents/reportTally/$(uid)).data.reporters;
      // A person can start or undo the 24-hour countdown of "Delete my account" (W10c): the only
      // thing he can change is deleteRequestedAt, set to the server time (start, only when it is
      // empty) or removed again (undo). A blocked person cannot.
      allow update: if isSelf(uid)
        && resource.data.blocked == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleteRequestedAt'])
        && ((resource.data.get('deleteRequestedAt', null) == null
             && request.resource.data.get('deleteRequestedAt', null) == request.time)
            || (resource.data.get('deleteRequestedAt', null) != null
                && request.resource.data.get('deleteRequestedAt', null) == null));
      // W27e (Edit my profile): a person can change his own name, contact number and, for a
      // student, school. A blocked person cannot (the block is by name). A driver's contact
      // number must change in the SAME save in his drivers record, and when his NAME changes the
      // same save must leave him pending (an approved driver goes back to pending: the owner
      // approved a person he met under that name). The page also refuses while a ride is open.
      allow update: if isSelf(uid)
        && resource.data.blocked == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'contactNumber', 'school'])
        && isText(request.resource.data.name, 60)
        && isPhone(request.resource.data.contactNumber)
        && ((resource.data.role == 'student'
             && isText(request.resource.data.school, 80))
            || (resource.data.role == 'driver'
                && !('school' in request.resource.data)
                && (request.resource.data.contactNumber == resource.data.contactNumber
                    || getAfter(/databases/$(database)/documents/drivers/$(uid)).data.contactNumber
                       == request.resource.data.contactNumber)
                && (request.resource.data.name == resource.data.name
                    || getAfter(/databases/$(database)/documents/drivers/$(uid)).data.approvalStatus == 'pending')));
      // An admin can remove a profile (the login in Authentication stays). A person can delete
      // his own profile (W10b, Delete my account) only when 24 hours have passed since he asked
      // (W10c), he is not blocked (so a blocked person cannot wipe his account and sign up again,
      // and a block that arrives during the 24 hours stops the deletion), and he has no open
      // request (his lock).
      allow delete: if isAdmin()
        || (isSelf(uid) && resource.data.blocked == false
            && resource.data.get('deleteRequestedAt', null) != null
            && resource.data.deleteRequestedAt <= request.time - duration.value(24, 'h')
            && !exists(/databases/$(database)/documents/locks/$(uid)));
    }

    function isNewStudent(d) {
      return d.keys().hasOnly(['name', 'role', 'school', 'contactNumber', 'inviteCode', 'createdAt', 'consentAt', 'blocked'])
        && d.keys().hasAll(['name', 'role', 'school', 'contactNumber', 'inviteCode', 'createdAt', 'consentAt', 'blocked'])
        && d.role == 'student'
        && isText(d.name, 60)
        && isText(d.school, 80)
        && isPhone(d.contactNumber)
        && d.createdAt == request.time
        && d.consentAt == request.time
        && d.blocked == false
        && d.inviteCode == pilotCode();
    }

    function isNewDriver(d) {
      return d.keys().hasOnly(['name', 'role', 'contactNumber', 'createdAt', 'consentAt', 'blocked'])
        && d.keys().hasAll(['name', 'role', 'contactNumber', 'createdAt', 'consentAt', 'blocked'])
        && d.role == 'driver'
        && isText(d.name, 60)
        && isPhone(d.contactNumber)
        && d.createdAt == request.time
        && d.consentAt == request.time
        && d.blocked == false;
    }

    // ---- drivers: vehicle details and approval status ----
    // A driver can create only a "pending" record for himself, in the same
    // batch as his users record. The owner switches approvalStatus to
    // "approved" in the Firebase console (the console ignores these rules).
    match /drivers/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if isSelf(uid)
        && isNewDriverRecord(request.resource.data)
        && getAfter(/databases/$(database)/documents/users/$(uid)).data.role == 'driver';
      // A driver can change his own vehicle type and plate number, but a change
      // always puts his account back to "pending" in the same write, so the owner
      // checks the vehicle again before he can accept rides. He can never set
      // "approved" himself (only the owner can, in the console).
      allow update: if isSelf(uid)
        && resource.data.approvalStatus in ['approved', 'pending']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['vehicleType', 'plateNumber', 'approvalStatus'])
        && request.resource.data.approvalStatus == 'pending'
        && isText(request.resource.data.vehicleType, 30)
        && isText(request.resource.data.plateNumber, 12);
      // W27e: a driver's contact number changes here in the same save as his profile (the users
      // rule checks this record with getAfter), and a NAME change in the same save puts an
      // approved driver back to pending. He can never set "approved" himself.
      allow update: if isSelf(uid)
        && resource.data.approvalStatus in ['approved', 'pending']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['contactNumber', 'approvalStatus'])
        && isPhone(request.resource.data.contactNumber)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['contactNumber'])
            || getAfter(/databases/$(database)/documents/users/$(uid)).data.contactNumber
               == request.resource.data.contactNumber)
        && (request.resource.data.approvalStatus == resource.data.approvalStatus
            || (request.resource.data.approvalStatus == 'pending'
                && getAfter(/databases/$(database)/documents/users/$(uid)).data.name
                   != get(/databases/$(database)/documents/users/$(uid)).data.name));
      // An admin can switch approvalStatus (and nothing else) between approved and pending.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approvalStatus', 'approvedAt'])
        && request.resource.data.approvalStatus in ['approved', 'pending']
        // W27b: the date of the approval is the server time (or removed when set back to pending).
        && (!('approvedAt' in request.resource.data)
            || request.resource.data.approvedAt == null
            || request.resource.data.approvedAt == request.time
            || request.resource.data.approvedAt == resource.data.get('approvedAt', null));
      // An admin can remove a driver record. A driver can delete his own record only in the
      // same save that deletes his profile (W10b).
      allow delete: if isAdmin()
        || (isSelf(uid) && !existsAfter(/databases/$(database)/documents/users/$(uid)));
    }

    function isNewDriverRecord(d) {
      return d.keys().hasOnly(['vehicleType', 'plateNumber', 'contactNumber', 'approvalStatus', 'available'])
        && d.keys().hasAll(['vehicleType', 'plateNumber', 'contactNumber', 'approvalStatus', 'available'])
        && isText(d.vehicleType, 30)
        && isText(d.plateNumber, 12)
        && isPhone(d.contactNumber)
        && d.approvalStatus == 'pending'
        && d.available == false;
    }

    // ---- accountNotes: the owner's private note about a person (W27c) ----
    // Only an admin can read, write or delete it. One text of 1 to 200 characters and the time
    // it was saved. The person can never read it (it is not in his own records).
    match /accountNotes/{uid} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['text', 'updatedAt'])
        && request.resource.data.keys().hasAll(['text', 'updatedAt'])
        && isText(request.resource.data.text, 200)
        && request.resource.data.updatedAt == request.time;
    }

    // ---- removedUsers: the owner's list of people removed from the admin page ----
    // Only an admin can read, add or delete a note. It holds no more than the
    // person's own profile fields, and the admin deletes it when no longer needed.
    match /removedUsers/{uid} {
      allow read, delete: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'role', 'contactNumber', 'school', 'vehicleType', 'plateNumber', 'removedAt'])
        && request.resource.data.keys().hasAll(['name', 'role', 'contactNumber', 'removedAt'])
        && request.resource.data.removedAt == request.time;
    }

    // ---- rides: a student's ride requests ----
    // A request is created together with a small "lock" record (below). The
    // lock can only exist once per student, so a student can have only one open
    // request at a time. Drivers will be able to read open requests in the
    // next stage.
    match /rides/{rideId} {
      // The admin (the owner's page) can also read rides, only to delete a removed
      // student's rides (W25). The admin check is last, so it costs nothing for others.
      // A student reads his own rides. An approved driver can read rides that
      // are still open ("requested"); his query must ask for status == "requested".
      // Expired-but-unclosed requests are hidden by the driver's page, not by the rules
      // (rules cannot compare a query against the phone's clock).
      allow read: if isSelf(resource.data.studentId)
        || isSelf(resource.data.driverId)
        || (resource.data.status == 'requested' && isApprovedDriver())
        || isAdmin();
      allow create: if isActiveStudent()
        && isNewRide(request.resource.data)
        && existsAfter(/databases/$(database)/documents/locks/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/locks/$(request.auth.uid)).data.rideId == rideId;
      // The student can cancel his own request while it is open or accepted (the
      // "On the way" button will close this window in the next step), or close it
      // once it has really run out of time. Nothing else may change from his side.
      // If the driver has been "on the way" for 5 minutes or more, the student may
      // cancel too (for example when the driver never comes). The choice is his.
      allow update: if isSelf(resource.data.studentId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && ((resource.data.status in ['requested', 'accepted'] && request.resource.data.status == 'cancelled')
            || (resource.data.status == 'on_the_way'
                && request.resource.data.status == 'cancelled'
                && resource.data.startedAt <= request.time - duration.value(5, 'm'))
            || (resource.data.status == 'requested'
                && request.resource.data.status == 'expired'
                && resource.data.expiresAt <= request.time));

      // The student agrees to the final fare. Until he does (or the driver accepts his
      // counter-offer), the driver cannot tap "On the way". He can agree when he sent no
      // counter-offer, or after the driver has answered it.
      allow update: if isSelf(resource.data.studentId)
        && resource.data.status == 'accepted'
        && resource.data.get('fareAgreed', false) != true
        && (resource.data.counterOffer == null || resource.data.get('counterAnswer', null) != null)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fareAgreed'])
        && request.resource.data.fareAgreed == true;

      // The student declines the fare (before agreeing): the request opens again for
      // other drivers.
      allow update: if isSelf(resource.data.studentId)
        && resource.data.status == 'accepted'
        && resource.data.get('fareAgreed', false) != true
        && isReopened(request.resource.data, resource.data);

      // The driver releases an accepted ride (before "On the way"): the request opens
      // again for other drivers.
      allow update: if isSelf(resource.data.driverId)
        && resource.data.status == 'accepted'
        && isReopened(request.resource.data, resource.data);

      // The student can send ONE counter-offer while the ride is accepted: a whole
      // number of pesos, lower than the driver's fare. Once counterOffer is set it can
      // never be changed again (the rule needs it to be empty), so it is one time only.
      allow update: if isSelf(resource.data.studentId)
        && resource.data.status == 'accepted'
        && resource.data.counterOffer == null
        && resource.data.get('fareAgreed', false) != true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['counterOffer'])
        && request.resource.data.counterOffer is int
        && request.resource.data.counterOffer >= 1
        && request.resource.data.counterOffer < resource.data.fare;

      // An approved driver accepts a request that is still open and not expired,
      // and types the fare. The first write wins: after it, the status is no longer
      // "requested", so every later accept is refused. His name, vehicle and contact
      // number are copied from his own records (the rules check they match).
      allow update: if isApprovedDriver()
        && resource.data.status == 'requested'
        && resource.data.expiresAt > request.time
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'driverId', 'fare', 'driverName', 'vehicleType', 'plateNumber', 'driverContact', 'acceptedAt'])
        && request.resource.data.status == 'accepted'
        && request.resource.data.driverId == request.auth.uid
        && request.resource.data.fare is int
        && request.resource.data.fare >= 1
        && request.resource.data.fare <= 5000
        && request.resource.data.acceptedAt == request.time
        && request.resource.data.driverName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name
        && request.resource.data.vehicleType == get(/databases/$(database)/documents/drivers/$(request.auth.uid)).data.vehicleType
        && request.resource.data.plateNumber == get(/databases/$(database)/documents/drivers/$(request.auth.uid)).data.plateNumber
        && request.resource.data.driverContact == get(/databases/$(database)/documents/drivers/$(request.auth.uid)).data.contactNumber;

      // The accepting driver answers the student's counter-offer once: either
      // "accepted" (the fare becomes the offer) or "kept" (the fare stays).
      allow update: if isApprovedDriverAny()
        && isSelf(resource.data.driverId)
        && resource.data.status == 'accepted'
        && resource.data.counterOffer != null
        && resource.data.get('counterAnswer', null) == null
        && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['counterAnswer'])
             && request.resource.data.counterAnswer == 'kept')
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['counterAnswer', 'fare'])
                && request.resource.data.counterAnswer == 'accepted'
                && request.resource.data.fare == resource.data.counterOffer));

      // The accepting driver moves his own ride forward: "On the way", then "Completed".
      // "On the way" needs the student's agreement to the fare first. After it, the
      // student can cancel only when 5 minutes have passed (his rule above).
      allow update: if isApprovedDriverAny()
        && isSelf(resource.data.driverId)
        && resource.data.status == 'accepted'
        && (resource.data.get('fareAgreed', false) == true || resource.data.get('counterAnswer', null) == 'accepted')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'startedAt'])
        && request.resource.data.status == 'on_the_way'
        && request.resource.data.startedAt == request.time;

      allow update: if isApprovedDriverAny()
        && isSelf(resource.data.driverId)
        && resource.data.status == 'on_the_way'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'completedAt'])
        && request.resource.data.status == 'completed'
        && request.resource.data.completedAt == request.time;

      // Tidy-up: the student can delete his own finished ride once its 30 days are
      // over (deleteAfter has passed). The driver of a finished ride can too (item 20.8), but
      // only in the same save that deletes the private record, so the student's name and
      // contact number never stay behind without their ride.
      // Also allowed at any time once his own profile is deleted (W10b: in the same save, or in the later small saves).
      allow delete: if (isSelf(resource.data.studentId)
        && resource.data.status in ['completed', 'cancelled', 'expired']
        && (resource.data.deleteAfter <= request.time
            || !existsAfter(/databases/$(database)/documents/users/$(request.auth.uid))))
        || (isSelf(resource.data.driverId)
            && resource.data.status in ['completed', 'cancelled']
            && resource.data.deleteAfter <= request.time
            && !existsAfter(/databases/$(database)/documents/rides/$(rideId)/private/student))
        || isAdmin(); // W25: the owner removes a student's rides with his account

      // The student's name and contact number live in a small private record next
      // to the ride, so drivers cannot see them before accepting.
      match /private/{docId} {
        // W20: the driver reads it only after the fare is agreed (see driverMaySeeStudent).
        allow read: if docId == 'student'
          && (isSelf(get(/databases/$(database)/documents/rides/$(rideId)).data.studentId)
              || driverMaySeeStudent(get(/databases/$(database)/documents/rides/$(rideId)).data));
        allow create: if docId == 'student'
          && isSelf(getAfter(/databases/$(database)/documents/rides/$(rideId)).data.studentId)
          && !exists(/databases/$(database)/documents/rides/$(rideId))
          && request.resource.data.keys().hasOnly(['name', 'contactNumber'])
          && request.resource.data.keys().hasAll(['name', 'contactNumber'])
          && request.resource.data.name == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name
          && request.resource.data.contactNumber == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.contactNumber;
        // Tidy-up: deleted by the student, or by the driver of the ride, after the ride's 30 days
        // are over (item 20.8), or by the owner (W25).
        allow delete: if (docId == 'student'
          && isSelf(get(/databases/$(database)/documents/rides/$(rideId)).data.studentId)
          && get(/databases/$(database)/documents/rides/$(rideId)).data.status in ['completed', 'cancelled', 'expired']
          && (get(/databases/$(database)/documents/rides/$(rideId)).data.deleteAfter <= request.time
              || !existsAfter(/databases/$(database)/documents/users/$(request.auth.uid))))
          || (docId == 'student' && driverMayTidy(rideId))
          || (docId == 'student' && isAdmin()); // W25
      }
    }

    // ---- locks: one per student while a request is open ----
    match /locks/{uid} {
      allow read: if isSelf(uid);
      // Only a create is allowed (no updates), so a second lock cannot be made.
      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['rideId', 'studentId'])
        && request.resource.data.keys().hasAll(['rideId', 'studentId'])
        && request.resource.data.studentId == uid
        && request.resource.data.rideId is string
        && !exists(/databases/$(database)/documents/rides/$(request.resource.data.rideId))
        && getAfter(/databases/$(database)/documents/rides/$(request.resource.data.rideId)).data.studentId == uid;
      // The lock can go in four cases: when its ride no longer exists (for example the
      // owner deleted it), so a student is never stuck; in the same batch that cancels or expires
      // the ride; after the ride is completed; or, as a safety valve, when a ride has
      // been "on the way" for more than 6 hours (for example if the driver never
      // tapped Completed), so a student is never stuck.
      allow delete: if (isSelf(uid)
        && (!exists(/databases/$(database)/documents/rides/$(resource.data.rideId))
            || (get(/databases/$(database)/documents/rides/$(resource.data.rideId)).data.status in ['requested', 'accepted']
             && getAfter(/databases/$(database)/documents/rides/$(resource.data.rideId)).data.status in ['cancelled', 'expired'])
            || (get(/databases/$(database)/documents/rides/$(resource.data.rideId)).data.status == 'on_the_way'
                && get(/databases/$(database)/documents/rides/$(resource.data.rideId)).data.startedAt <= request.time - duration.value(5, 'm')
                && getAfter(/databases/$(database)/documents/rides/$(resource.data.rideId)).data.status == 'cancelled')
            || get(/databases/$(database)/documents/rides/$(resource.data.rideId)).data.status == 'completed'
            || (get(/databases/$(database)/documents/rides/$(resource.data.rideId)).data.status == 'on_the_way'
                && get(/databases/$(database)/documents/rides/$(resource.data.rideId)).data.startedAt <= request.time - duration.value(6, 'h'))))
        || isAdmin(); // W25: the owner removes a student with an open request
    }

    // A signed-in driver whom the owner has approved, blocked or not. Used for finishing
    // a ride he already has (W22): a driver who gets blocked in the middle of a ride can
    // still move it forward, so the student is never stuck.
    function isApprovedDriverAny() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'driver'
        && get(/databases/$(database)/documents/drivers/$(request.auth.uid)).data.approvalStatus == 'approved';
    }

    // A signed-in driver who is not blocked and whom the owner has approved.
    // Only this driver can see open requests and accept a new ride.
    function isApprovedDriver() {
      return isApprovedDriverAny()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.blocked == false;
    }

    // W20: the accepting driver can read the student's name and contact number only after the
    // student agreed to the fare (fareAgreed), or after the driver accepted the student's
    // counter-offer (the fare then counts as agreed by both). Before that, only the student
    // reads his own record, so a driver cannot collect numbers by accepting and releasing rides.
    function driverMaySeeStudent(ride) {
      return ride.driverId == request.auth.uid
        && ride.status in ['accepted', 'on_the_way']
        && (ride.get('fareAgreed', false) == true || ride.get('counterAnswer', null) == 'accepted');
    }

    // Item 20.8: the driver of a finished ride can tidy it up once its 30 days are over
    // (deleteAfter has passed). One lookup for the ride.
    function driverMayTidy(rideId) {
      let ride = get(/databases/$(database)/documents/rides/$(rideId)).data;
      return isSelf(ride.driverId)
        && ride.status in ['completed', 'cancelled']
        && ride.deleteAfter <= request.time;
    }

    // A ride that goes back to the open list: the driver and everything he added
    // (fare, offers, agreement, his details) are cleared, and the status is "requested" again.
    function isReopened(after, before) {
      return after.diff(before).affectedKeys().hasOnly(['status', 'driverId', 'fare', 'counterOffer', 'counterAnswer', 'fareAgreed', 'driverName', 'vehicleType', 'plateNumber', 'driverContact', 'acceptedAt'])
        && after.status == 'requested'
        && after.driverId == null
        && after.fare == null
        && after.counterOffer == null
        && after.get('counterAnswer', null) == null
        && after.get('fareAgreed', null) == null
        && after.get('driverName', null) == null
        && after.get('vehicleType', null) == null
        && after.get('plateNumber', null) == null
        && after.get('driverContact', null) == null
        && after.get('acceptedAt', null) == null;
    }

    function isActiveStudent() {
      let account = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return account.role == 'student' && account.blocked == false;
    }

    // A pickup or drop-off point: latitude, longitude (inside Bohol) and a short label.
    function isPoint(p) {
      return p is map
        && p.keys().hasOnly(['lat', 'lng', 'label'])
        && p.keys().hasAll(['lat', 'lng', 'label'])
        && p.lat is number && p.lng is number
        && p.lat >= 9.3 && p.lat <= 10.3
        && p.lng >= 123.6 && p.lng <= 124.8
        && p.label is string && p.label.size() <= 60;
    }

    function isNewRide(d) {
      return d.keys().hasOnly(['studentId', 'driverId', 'pickup', 'dropoff', 'fare', 'counterOffer', 'status', 'neededBy', 'expiresAt', 'createdAt', 'deleteAfter'])
        && d.keys().hasAll(['studentId', 'driverId', 'pickup', 'dropoff', 'fare', 'counterOffer', 'status', 'expiresAt', 'createdAt', 'deleteAfter'])
        && d.studentId == request.auth.uid
        && d.driverId == null
        && d.fare == null
        && d.counterOffer == null
        && d.status == 'requested'
        && isPoint(d.pickup)
        && isPoint(d.dropoff)
        && d.createdAt == request.time
        // Open for at least a moment and at most 24 hours (plus 15 minutes of slack for phone clocks).
        && d.expiresAt is timestamp
        && d.expiresAt > request.time
        && d.expiresAt <= request.time + duration.value(1455, 'm')
        // "Needed by" was removed. Old rides have it, and a page that is not updated yet
        // may still send it as empty; nothing else is allowed in it.
        && (!('neededBy' in d) || d.neededBy == null)
        // The record is kept for about 30 days (the tidy-up step comes later).
        && d.deleteAfter is timestamp
        && d.deleteAfter > request.time + duration.value(29, 'd')
        && d.deleteAfter <= request.time + duration.value(31, 'd');
    }

    // ---- reports (W22) ----
    // A student or a driver reports the other person on a past ride ("person"), or the
    // Hatud app ("app"). One report per person per ride and kind: the document id is
    // rideId_reporterId for a person and rideId_app_reporterId for the app. A report can
    // only be created, never changed. Each person reads only his own reports; the owner
    // reads all of them on the admin page.
    match /reports/{reportId} {
      allow read: if isSelf(resource.data.reporterId) || isAdmin();
      // An admin can mark a report new or reviewed, and delete it when it is no longer needed.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['new', 'reviewed'];
      allow delete: if isAdmin();
      allow create: if request.auth != null
        && request.resource.data.rideId is string
        && ((request.resource.data.get('targetType', '') == 'person'
             && reportId == request.resource.data.rideId + '_' + request.auth.uid
             && isNewPersonReport(request.resource.data))
            || (request.resource.data.get('targetType', '') == 'app'
             && reportId == request.resource.data.rideId + '_app_' + request.auth.uid
             && isNewAppReport(request.resource.data)));
    }

    // A report about the other person on a ride that had a driver and is finished.
    // The reporter must also be on the private list of reporters of that person, which
    // is written in the same save (see reportTally below), so a report cannot skip the count.
    function isNewPersonReport(d) {
      let ride = get(/databases/$(database)/documents/rides/$(d.rideId)).data;
      let account = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return d.keys().hasOnly(['rideId', 'reporterId', 'reporterRole', 'targetType', 'reportedId', 'reason', 'details', 'status', 'createdAt'])
        && d.keys().hasAll(['rideId', 'reporterId', 'reporterRole', 'targetType', 'reportedId', 'reason', 'details', 'status', 'createdAt'])
        && account.blocked == false
        && d.reporterId == request.auth.uid
        && d.reporterRole == account.role
        && ride.driverId != null
        && ride.status in ['completed', 'cancelled']
        && ((account.role == 'student' && ride.studentId == request.auth.uid && d.reportedId == ride.driverId)
            || (account.role == 'driver' && ride.driverId == request.auth.uid && d.reportedId == ride.studentId))
        && d.reason in ['unreasonable_fare', 'unsafe_or_rude', 'no_show', 'wrong_vehicle', 'refused_to_pay', 'other']
        && d.details is string && d.details.size() <= 200
        && d.status == 'new'
        && d.createdAt == request.time
        && existsAfter(/databases/$(database)/documents/reportTally/$(d.reportedId))
        && request.auth.uid in getAfter(/databases/$(database)/documents/reportTally/$(d.reportedId)).data.reporters;
    }

    // A report about the app on any past ride the reporter was on (even one that never
    // got a driver). It never counts toward a block.
    function isNewAppReport(d) {
      let ride = get(/databases/$(database)/documents/rides/$(d.rideId)).data;
      let account = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return d.keys().hasOnly(['rideId', 'reporterId', 'reporterRole', 'targetType', 'reason', 'details', 'status', 'createdAt'])
        && d.keys().hasAll(['rideId', 'reporterId', 'reporterRole', 'targetType', 'reason', 'details', 'status', 'createdAt'])
        && account.blocked == false
        && d.reporterId == request.auth.uid
        && d.reporterRole == account.role
        && ride.status in ['completed', 'cancelled', 'expired']
        && ((account.role == 'student' && ride.studentId == request.auth.uid)
            || (account.role == 'driver' && ride.driverId == request.auth.uid))
        && d.reason in ['app_bug', 'map_wrong', 'slow_or_stuck', 'confusing', 'other']
        && d.details is string && d.details.size() <= 200
        && d.status == 'new'
        && d.createdAt == request.time;
    }

    // ---- reportTally (W22): who reported a person ----
    // One private document per reported person: the list of DIFFERENT people who reported
    // him, and the id of the latest report. Only the owner can read it, so the reported
    // person never learns who reported him. A reporter can add only himself to the list,
    // and only in the same save that creates his own report about that person.
    // When the list holds 3 people, a reporter can block the person (see users above).
    // The owner deletes the document to reset the count when unblocking.
    match /reportTally/{personId} {
      allow read: if isAdmin();
      allow delete: if isAdmin();
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['reporters', 'lastReportId'])
        && request.resource.data.keys().hasAll(['reporters', 'lastReportId'])
        && request.resource.data.reporters == [request.auth.uid]
        && isReportProof(personId, request.resource.data.lastReportId);
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reporters', 'lastReportId'])
        && ((!(request.auth.uid in resource.data.reporters)
             && request.resource.data.reporters == resource.data.reporters.concat([request.auth.uid]))
            || (request.auth.uid in resource.data.reporters
                && request.resource.data.reporters == resource.data.reporters))
        && isReportProof(personId, request.resource.data.lastReportId);
    }

    // The save that changes a tally must also create a real report by the same person
    // about the same person.
    function isReportProof(personId, reportId) {
      return reportId is string
        && !exists(/databases/$(database)/documents/reports/$(reportId))
        && existsAfter(/databases/$(database)/documents/reports/$(reportId))
        && getAfter(/databases/$(database)/documents/reports/$(reportId)).data.reporterId == request.auth.uid
        && getAfter(/databases/$(database)/documents/reports/$(reportId)).data.reportedId == personId
        && getAfter(/databases/$(database)/documents/reports/$(reportId)).data.targetType == 'person';
    }

    // ---- appeals (W22) ----
    // A blocked person can send ONE appeal at a time (the document id is his own id, and
    // he cannot change it afterwards). The owner can deny it, or delete it so he can appeal
    // again. Unblocking deletes it.
    match /appeals/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if isSelf(uid)
        && get(/databases/$(database)/documents/users/$(uid)).data.blocked == true
        && request.resource.data.keys().hasOnly(['message', 'status', 'createdAt'])
        && request.resource.data.keys().hasAll(['message', 'status', 'createdAt'])
        && isText(request.resource.data.message, 300)
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['new', 'denied'];
      // A person can delete his own appeal only in the same save that deletes his profile (W10b).
      allow delete: if isAdmin()
        || (isSelf(uid) && !existsAfter(/databases/$(database)/documents/users/$(uid)));
    }

    // Everything not listed above is denied.
  }
}
