rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Small helper checks ----

    function isSelf(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isText(value, maxLength) {
      return value is string && value.size() > 0 && value.size() <= maxLength;
    }

    function isPhone(value) {
      return value is string && value.matches('^[0-9+() -]{7,20}$');
    }

    // The pilot invite code. Only these rules can read it.
    function pilotCode() {
      return get(/databases/$(database)/documents/settings/pilot).data.inviteCode;
    }

    // ---- settings: never readable or writable from the app ----
    // The owner edits settings/pilot in the Firebase console.
    match /settings/{document=**} {
      allow read, write: if false;
    }

    // ---- users: one profile per person, readable only by that person ----
    match /users/{uid} {
      allow read: if isSelf(uid);
      allow create: if isSelf(uid)
        && (isNewStudent(request.resource.data) || isNewDriver(request.resource.data));
      // No updates or deletes from the app for now.
    }

    function isNewStudent(d) {
      return d.keys().hasOnly(['name', 'role', 'school', 'contactNumber', 'inviteCode', 'createdAt', 'consentAt', 'blocked'])
        && d.keys().hasAll(['name', 'role', 'school', 'contactNumber', 'inviteCode', 'createdAt', 'consentAt', 'blocked'])
        && d.role == 'student'
        && isText(d.name, 60)
        && isText(d.school, 80)
        && isPhone(d.contactNumber)
        && d.createdAt == request.time
        && d.consentAt == request.time
        && d.blocked == false
        && d.inviteCode == pilotCode();
    }

    function isNewDriver(d) {
      return d.keys().hasOnly(['name', 'role', 'contactNumber', 'createdAt', 'consentAt', 'blocked'])
        && d.keys().hasAll(['name', 'role', 'contactNumber', 'createdAt', 'consentAt', 'blocked'])
        && d.role == 'driver'
        && isText(d.name, 60)
        && isPhone(d.contactNumber)
        && d.createdAt == request.time
        && d.consentAt == request.time
        && d.blocked == false;
    }

    // ---- drivers: vehicle details and approval status ----
    // A driver can create only a "pending" record for himself, in the same
    // batch as his users record. The owner switches approvalStatus to
    // "approved" in the Firebase console (the console ignores these rules).
    match /drivers/{uid} {
      allow read: if isSelf(uid);
      allow create: if isSelf(uid)
        && isNewDriverRecord(request.resource.data)
        && getAfter(/databases/$(database)/documents/users/$(uid)).data.role == 'driver';
      // No updates or deletes from the app for now.
    }

    function isNewDriverRecord(d) {
      return d.keys().hasOnly(['vehicleType', 'plateNumber', 'contactNumber', 'approvalStatus', 'available'])
        && d.keys().hasAll(['vehicleType', 'plateNumber', 'contactNumber', 'approvalStatus', 'available'])
        && d.vehicleType in ['tricycle', 'motorcycle', 'car', 'van']
        && isText(d.plateNumber, 12)
        && isPhone(d.contactNumber)
        && d.approvalStatus == 'pending'
        && d.available == false;
    }

    // ---- rides: a student's ride requests ----
    // A request is created together with a small "lock" record (below). The
    // lock can only exist once per student, so a student can have only one open
    // request at a time. Drivers will be able to read open requests in the
    // next stage.
    match /rides/{rideId} {
      // A student reads his own rides. An approved driver can read rides that
      // are still open ("requested"); his query must ask for status == "requested".
      // Expired-but-unclosed requests are hidden by the driver's page, not by the rules
      // (rules cannot compare a query against the phone's clock).
      allow read: if isSelf(resource.data.studentId)
        || isSelf(resource.data.driverId)
        || (resource.data.status == 'requested' && isApprovedDriver());
      allow create: if isActiveStudent()
        && isNewRide(request.resource.data)
        && existsAfter(/databases/$(database)/documents/locks/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/locks/$(request.auth.uid)).data.rideId == rideId;
      // The student can cancel his own request while it is open or accepted (the
      // "On the way" button will close this window in the next step), or close it
      // once it has really run out of time. Nothing else may change from his side.
      allow update: if isSelf(resource.data.studentId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && ((resource.data.status in ['requested', 'accepted'] && request.resource.data.status == 'cancelled')
            || (resource.data.status == 'requested'
                && request.resource.data.status == 'expired'
                && resource.data.expiresAt <= request.time));

      // The student can send ONE counter-offer while the ride is accepted: a whole
      // number of pesos, lower than the driver's fare. Once counterOffer is set it can
      // never be changed again (the rule needs it to be empty), so it is one time only.
      allow update: if isSelf(resource.data.studentId)
        && resource.data.status == 'accepted'
        && resource.data.counterOffer == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['counterOffer'])
        && request.resource.data.counterOffer is int
        && request.resource.data.counterOffer >= 1
        && request.resource.data.counterOffer < resource.data.fare;

      // An approved driver accepts a request that is still open and not expired,
      // and types the fare. The first write wins: after it, the status is no longer
      // "requested", so every later accept is refused. His name, vehicle and contact
      // number are copied from his own records (the rules check they match).
      allow update: if isApprovedDriver()
        && resource.data.status == 'requested'
        && resource.data.expiresAt > request.time
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'driverId', 'fare', 'driverName', 'vehicleType', 'plateNumber', 'driverContact', 'acceptedAt'])
        && request.resource.data.status == 'accepted'
        && request.resource.data.driverId == request.auth.uid
        && request.resource.data.fare is int
        && request.resource.data.fare >= 1
        && request.resource.data.fare <= 5000
        && request.resource.data.acceptedAt == request.time
        && request.resource.data.driverName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name
        && request.resource.data.vehicleType == get(/databases/$(database)/documents/drivers/$(request.auth.uid)).data.vehicleType
        && request.resource.data.plateNumber == get(/databases/$(database)/documents/drivers/$(request.auth.uid)).data.plateNumber
        && request.resource.data.driverContact == get(/databases/$(database)/documents/drivers/$(request.auth.uid)).data.contactNumber;

      // The accepting driver answers the student's counter-offer once: either
      // "accepted" (the fare becomes the offer) or "kept" (the fare stays).
      allow update: if isApprovedDriver()
        && isSelf(resource.data.driverId)
        && resource.data.status == 'accepted'
        && resource.data.counterOffer != null
        && resource.data.get('counterAnswer', null) == null
        && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['counterAnswer'])
             && request.resource.data.counterAnswer == 'kept')
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['counterAnswer', 'fare'])
                && request.resource.data.counterAnswer == 'accepted'
                && request.resource.data.fare == resource.data.counterOffer));

      // The accepting driver moves his own ride forward: "On the way", then "Completed".
      // After "On the way" the student can no longer cancel (his rule above only
      // covers requested and accepted rides).
      allow update: if isApprovedDriver()
        && isSelf(resource.data.driverId)
        && resource.data.status == 'accepted'
        && (resource.data.counterOffer == null || resource.data.get('counterAnswer', null) != null)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'startedAt'])
        && request.resource.data.status == 'on_the_way'
        && request.resource.data.startedAt == request.time;

      allow update: if isApprovedDriver()
        && isSelf(resource.data.driverId)
        && resource.data.status == 'on_the_way'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'completedAt'])
        && request.resource.data.status == 'completed'
        && request.resource.data.completedAt == request.time;

      // Tidy-up: the student can delete his own finished ride once its 30 days are
      // over (deleteAfter has passed). Only the student deletes, so his name and
      // contact number in the private record go away together with the ride.
      allow delete: if isSelf(resource.data.studentId)
        && resource.data.status in ['completed', 'cancelled', 'expired']
        && resource.data.deleteAfter <= request.time;

      // The student's name and contact number live in a small private record next
      // to the ride, so drivers cannot see them before accepting.
      match /private/{docId} {
        allow read: if docId == 'student'
          && (isSelf(get(/databases/$(database)/documents/rides/$(rideId)).data.studentId)
              || (get(/databases/$(database)/documents/rides/$(rideId)).data.driverId == request.auth.uid
                  && get(/databases/$(database)/documents/rides/$(rideId)).data.status in ['accepted', 'on_the_way']));
        allow create: if docId == 'student'
          && isSelf(getAfter(/databases/$(database)/documents/rides/$(rideId)).data.studentId)
          && !exists(/databases/$(database)/documents/rides/$(rideId))
          && request.resource.data.keys().hasOnly(['name', 'contactNumber'])
          && request.resource.data.keys().hasAll(['name', 'contactNumber'])
          && request.resource.data.name == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name
          && request.resource.data.contactNumber == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.contactNumber;
        // Tidy-up: deleted by the student after the ride's 30 days are over.
        allow delete: if docId == 'student'
          && isSelf(get(/databases/$(database)/documents/rides/$(rideId)).data.studentId)
          && get(/databases/$(database)/documents/rides/$(rideId)).data.status in ['completed', 'cancelled', 'expired']
          && get(/databases/$(database)/documents/rides/$(rideId)).data.deleteAfter <= request.time;
      }
    }

    // ---- locks: one per student while a request is open ----
    match /locks/{uid} {
      allow read: if isSelf(uid);
      // Only a create is allowed (no updates), so a second lock cannot be made.
      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['rideId', 'studentId'])
        && request.resource.data.keys().hasAll(['rideId', 'studentId'])
        && request.resource.data.studentId == uid
        && request.resource.data.rideId is string
        && !exists(/databases/$(database)/documents/rides/$(request.resource.data.rideId))
        && getAfter(/databases/$(database)/documents/rides/$(request.resource.data.rideId)).data.studentId == uid;
      // The lock can go in three cases: in the same batch that cancels or expires
      // the ride; after the ride is completed; or, as a safety valve, when a ride has
      // been "on the way" for more than 6 hours (for example if the driver never
      // tapped Completed), so a student is never stuck.
      allow delete: if isSelf(uid)
        && ((get(/databases/$(database)/documents/rides/$(resource.data.rideId)).data.status in ['requested', 'accepted']
             && getAfter(/databases/$(database)/documents/rides/$(resource.data.rideId)).data.status in ['cancelled', 'expired'])
            || get(/databases/$(database)/documents/rides/$(resource.data.rideId)).data.status == 'completed'
            || (get(/databases/$(database)/documents/rides/$(resource.data.rideId)).data.status == 'on_the_way'
                && get(/databases/$(database)/documents/rides/$(resource.data.rideId)).data.startedAt <= request.time - duration.value(6, 'h')));
    }

    // A signed-in driver who is not blocked and whom the owner has approved.
    function isApprovedDriver() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'driver'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.blocked == false
        && get(/databases/$(database)/documents/drivers/$(request.auth.uid)).data.approvalStatus == 'approved';
    }

    function isActiveStudent() {
      let account = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return account.role == 'student' && account.blocked == false;
    }

    // A pickup or drop-off point: latitude, longitude (inside Bohol) and a short label.
    function isPoint(p) {
      return p is map
        && p.keys().hasOnly(['lat', 'lng', 'label'])
        && p.keys().hasAll(['lat', 'lng', 'label'])
        && p.lat is number && p.lng is number
        && p.lat >= 9.3 && p.lat <= 10.3
        && p.lng >= 123.6 && p.lng <= 124.8
        && p.label is string && p.label.size() <= 60;
    }

    function isNewRide(d) {
      return d.keys().hasOnly(['studentId', 'driverId', 'pickup', 'dropoff', 'fare', 'counterOffer', 'status', 'neededBy', 'expiresAt', 'createdAt', 'deleteAfter'])
        && d.keys().hasAll(['studentId', 'driverId', 'pickup', 'dropoff', 'fare', 'counterOffer', 'status', 'neededBy', 'expiresAt', 'createdAt', 'deleteAfter'])
        && d.studentId == request.auth.uid
        && d.driverId == null
        && d.fare == null
        && d.counterOffer == null
        && d.status == 'requested'
        && isPoint(d.pickup)
        && isPoint(d.dropoff)
        && d.createdAt == request.time
        // Open for at least a moment and at most 24 hours (plus 15 minutes of slack for phone clocks).
        && d.expiresAt is timestamp
        && d.expiresAt > request.time
        && d.expiresAt <= request.time + duration.value(1455, 'm')
        // "Needed by" is optional, and must fall inside the open time.
        && (d.neededBy == null || (d.neededBy is timestamp && d.neededBy <= d.expiresAt))
        // The record is kept for about 30 days (the tidy-up step comes later).
        && d.deleteAfter is timestamp
        && d.deleteAfter > request.time + duration.value(29, 'd')
        && d.deleteAfter <= request.time + duration.value(31, 'd');
    }

    // Everything not listed above is denied.
  }
}
