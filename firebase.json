{
  "hosting": {
    "site": "hatud",
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      { "source": "/sw.js", "headers": [ { "key": "Cache-Control", "value": "no-cache" } ] },
      { "source": "/manifest.webmanifest", "headers": [ { "key": "Cache-Control", "value": "no-cache" } ] }
    ]
  },
  "firestore": {
    "database": "(default)",
    "location": "asia-southeast1",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
